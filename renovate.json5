{
  // Opens dependency-update PRs for every pin in the repo. Which manager owns what:
  //   npm             package.json + pnpm-lock.yaml
  //   github-actions  the action pins in .github/workflows/*.yaml
  // Cadence is the cron in .github/workflows/renovate.yaml, not an internal `schedule`, so a manual
  // workflow_dispatch works too.
  //
  // The shared presets carry the grouping, automerge, digest-pinning, typescript hold and the
  // vite/eslint major groupings. Only what is specific to this repo lives below.
  // WARNING: the combined non-major PR automerges, and merging to main runs deploy.yml, which publishes
  // to GitHub Pages. Every automerged bump therefore ships the site.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>yama6a/gha:default.json5",
    "github>yama6a/gha:node.json5",
  ],

  packageRules: [
    {
      // Next majors can change App Router/static-export semantics; a react major moves in lockstep.
      description: "next and react: their own PR, never automerged on major",
      matchPackageNames: ["next", "react", "react-dom"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
}
